<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF">

        <!-- Save status, shown at the right of the top bar (before the action icons) -->
        <TextView
            android:id="@+id/tvSaveState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:textColor="#16A34A"
            android:textSize="12sp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/docTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#F1F5F9"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabIndicatorColor="#2563EB"
        app:tabMinWidth="120dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="12dp" />

    <!-- Fixed to the screen width (no sideways scrolling, so sliders drag freely) -->
    <LinearLayout
        android:id="@+id/toolStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <!-- Mode picker: tap for a list of modes (room for more later) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/mode_annotate"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="textEnd"
                app:iconTint="#374151" />

            <View style="@style/ToolDivider" />

            <!-- View mode: select text to copy / highlight -->
            <LinearLayout
                android:id="@+id/viewTools"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/color"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/hlColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <View style="@style/ToolDivider" />

                <ImageButton
                    android:id="@+id/btnViewUndo"
                    style="@style/ToolButton"
                    android:contentDescription="@string/undo"
                    android:src="@drawable/ic_undo" />
            </LinearLayout>

            <!-- Annotate mode: pens -->
            <LinearLayout
                android:id="@+id/annotateTools"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


            <ImageButton
                android:id="@+id/btnPen"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_pen"
                android:src="@drawable/ic_pen" />

            <ImageButton
                android:id="@+id/btnHighlight"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_highlight"
                android:src="@drawable/ic_highlight" />

            <ImageButton
                android:id="@+id/btnEraser"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_eraser"
                android:src="@drawable/ic_eraser" />

            <ImageButton
                android:id="@+id/btnText"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_text"
                android:src="@drawable/ic_text" />

            <View style="@style/ToolDivider" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/eraserModeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEraseStroke"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/erase_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErasePixel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/erase_pixel" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View style="@style/ToolDivider" />

            <TextView
                android:id="@+id/btnSizeMinus"
                style="@style/StepButton"
                android:contentDescription="@string/size_minus"
                android:text="−" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:maxWidth="360dp"
                android:minWidth="120dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb"
                android:contentDescription="@string/size" />

            <TextView
                android:id="@+id/btnSizePlus"
                style="@style/StepButton"
                android:contentDescription="@string/size_plus"
                android:text="+" />

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="52dp"
                android:layout_height="36dp"
                android:background="@drawable/size_box_bg"
                android:clickable="true"
                android:contentDescription="@string/size_type"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#111827"
                android:textSize="15sp" />

            <View style="@style/ToolDivider" />

            <ImageButton
                android:id="@+id/btnUndo"
                style="@style/ToolButton"
                android:contentDescription="@string/undo"
                android:src="@drawable/ic_undo" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnSearchPrev"
            style="@style/ToolButton"
            android:contentDescription="@string/search_prev"
            android:src="@drawable/ic_chevron_up" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            style="@style/ToolButton"
            android:contentDescription="@string/search_next"
            android:src="@drawable/ic_chevron_down" />

        <ImageButton
            android:id="@+id/btnSearchList"
            style="@style/ToolButton"
            android:contentDescription="@string/search_list"
            android:src="@drawable/ic_list" />

        <ImageButton
            android:id="@+id/btnSearchClose"
            style="@style/ToolButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:id="@+id/chromeDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.titipong.pdfwriter.ui.ZoomRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E5E7EB"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textColor="#111827"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_body"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/open_pdf" />

            <TextView
                android:id="@+id/tvCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Text selection actions (view mode) -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/selection_bar_bg"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copy"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelHighlight"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/highlight"
                app:icon="@drawable/ic_highlight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelUnderline"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/underline"
                app:icon="@drawable/ic_underline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHlRecolor"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_color"
                app:icon="@drawable/ic_palette" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNoteEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:visibility="gone"
                app:icon="@drawable/ic_pen" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHlDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_highlight"
                app:icon="@drawable/ic_delete"
                app:iconTint="#DC2626"
                android:textColor="#DC2626" />

            <ImageButton
                android:id="@+id/btnSelClose"
                style="@style/ToolButton"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Reading mode -->
        <LinearLayout
            android:id="@+id/readingPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/readingBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/readingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reading_title"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextSmaller"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reading_smaller"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextBigger"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reading_bigger"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReadingExit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/reading_exit" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/readingList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Page overview / bookmarks panel -->
        <LinearLayout
            android:id="@+id/pagesPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F3F4F6"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/panelTabs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:tabGravity="start"
                    app:tabMode="scrollable" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddBlank"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_blank_page"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDuplicatePages"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeletePages"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:icon="@drawable/ic_chevron_down"
                    app:iconGravity="textEnd" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPages"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/edit_pages" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/save"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnClosePanel"
                    style="@style/ToolButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:id="@+id/panelHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/edit_pages_hint"
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pagesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmarksList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bookmarksEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/bookmarks_empty"
                    android:textColor="#6B7280"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
