<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF" />

    <HorizontalScrollView
        android:id="@+id/toolStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnPages"
                style="@style/ToolButton"
                android:contentDescription="@string/pages"
                android:src="@drawable/ic_pages" />

            <ImageButton
                android:id="@+id/btnBookmark"
                style="@style/ToolButton"
                android:contentDescription="@string/bookmark_toggle"
                android:src="@drawable/ic_bookmark" />

            <View style="@style/ToolDivider" />

            <ImageButton
                android:id="@+id/btnPen"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_pen"
                android:src="@drawable/ic_pen" />

            <ImageButton
                android:id="@+id/btnHighlight"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_highlight"
                android:src="@drawable/ic_highlight" />

            <ImageButton
                android:id="@+id/btnEraser"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_eraser"
                android:src="@drawable/ic_eraser" />

            <ImageButton
                android:id="@+id/btnText"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_text"
                android:src="@drawable/ic_text" />

            <View style="@style/ToolDivider" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View style="@style/ToolDivider" />

            <TextView
                android:id="@+id/btnSizeMinus"
                style="@style/StepButton"
                android:contentDescription="@string/size_minus"
                android:text="−" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/size" />

            <TextView
                android:id="@+id/btnSizePlus"
                style="@style/StepButton"
                android:contentDescription="@string/size_plus"
                android:text="+" />

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#111827"
                android:textSize="14sp" />

            <View style="@style/ToolDivider" />

            <ImageButton
                android:id="@+id/btnUndo"
                style="@style/ToolButton"
                android:contentDescription="@string/undo"
                android:src="@drawable/ic_undo" />

            <TextView
                android:id="@+id/tvSaveState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="90dp"
                android:textColor="#16A34A"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.titipong.pdfwriter.ui.ZoomRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E5E7EB"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textColor="#111827"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_body"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/open_pdf" />
        </LinearLayout>

        <!-- Page overview / bookmarks panel -->
        <LinearLayout
            android:id="@+id/pagesPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F3F4F6"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/panelTabs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:tabGravity="start"
                    app:tabMode="scrollable" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddBlank"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_blank_page"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeletePages"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delete_pages"
                    android:textColor="#DC2626"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPages"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/edit_pages" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/save"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnClosePanel"
                    style="@style/ToolButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:id="@+id/panelHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/edit_pages_hint"
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pagesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmarksList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bookmarksEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/bookmarks_empty"
                    android:textColor="#6B7280"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
