<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnPen"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_pen"
                android:src="@drawable/ic_pen" />

            <ImageButton
                android:id="@+id/btnHighlight"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_highlight"
                android:src="@drawable/ic_highlight" />

            <ImageButton
                android:id="@+id/btnEraser"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_eraser"
                android:src="@drawable/ic_eraser" />

            <ImageButton
                android:id="@+id/btnText"
                style="@style/ToolButton"
                android:contentDescription="@string/tool_text"
                android:src="@drawable/ic_text" />

            <View style="@style/ToolDivider" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View style="@style/ToolDivider" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/size" />

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#374151"
                android:textSize="13sp" />

            <View style="@style/ToolDivider" />

            <ImageButton
                android:id="@+id/btnUndo"
                style="@style/ToolButton"
                android:contentDescription="@string/undo"
                android:src="@drawable/ic_undo" />

            <TextView
                android:id="@+id/tvSaveState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="90dp"
                android:textColor="#16A34A"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.titipong.pdfwriter.ui.ZoomRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E5E7EB"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textColor="#111827"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_body"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/open_pdf" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
